# Copy this file to .env and fill it in. Never commit .env.

# MongoDB connection string.
#  - MongoDB Atlas (free): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
#  - Local MongoDB:        mongodb://127.0.0.1:27017/portfolio
MONGODB_URI=

# Admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs the login session. Random string of 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Address(es) of the frontend that may call this API, comma separated.
# Local: http://localhost:5173    Online: https://your-site.vercel.app
CLIENT_ORIGIN=http://localhost:5173

PORT=3001

# Set to true when the API runs behind a proxy / HTTPS host (Render, Railway, Fly, Vercel...)
TRUST_PROXY=false
# Cookie mode between two different domains (frontend and backend on different sites). Leave empty to let the server decide.
# strict = same site (default locally), none = different domains in production (needs HTTPS)
COOKIE_SAMESITE=
